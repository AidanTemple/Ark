<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- net8.0-windows alone doesn't give the platform-compatibility
         analyzer (CA1416) a minimum OS version, so it flags every
         Windows-only MonoGame/GraphicsDeviceManager call as "reachable
         on all platforms" even though this project only ever targets
         Windows. -->
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <RootNamespace>Ark</RootNamespace>
    <AssemblyName>Ark</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.4.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Content\**\*.xnb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
