<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- net8.0-windows alone doesn't give the platform-compatibility
         analyzer (CA1416) a minimum OS version, so it flags every
         Windows-only MonoGame/GraphicsDeviceManager call as "reachable
         on all platforms" even though this project only ever targets
         Windows. -->
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <RootNamespace>Ark</RootNamespace>
    <AssemblyName>Ark</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.4.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Existing art has no source files in the repo (only the precompiled
         .xnb output survived from before this project's history), so it's
         still just copied as-is rather than run through the pipeline. -->
    <None Include="Content\**\*.xnb" CopyToOutputDirectory="PreserveNewest" />

    <!-- New assets: MonoGame.Content.Builder.Task (referenced above) builds
         this at compile time from source images/audio/fonts listed in it,
         same output convention (Content/) as the precompiled .xnb above. -->
    <MonoGameContentReference Include="Content\Content.mgcb" />
  </ItemGroup>
</Project>
